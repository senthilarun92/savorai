# ============================================================
# SavorAI Environment Configuration
# ============================================================

# Database
# Local example:
DATABASE_URL=postgresql://username:password@localhost:5432/savorai

# JWT Authentication
# Generate a strong random secret for production.
JWT_SECRET_KEY=your_secure_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Local:
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Production example:
# GOOGLE_REDIRECT_URI=https://your-service.onrender.com/api/auth/google/callback

# Environment
# development or production
SAVORAI_ENV=development
